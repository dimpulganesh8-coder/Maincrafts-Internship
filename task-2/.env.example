# Server Port
PORT=5001

# MongoDB Connection URI
# Option 1: MongoDB Atlas (Recommended for Production / Internship Submission)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/maincrafts_todo?retryWrites=true&w=majority&appName=Cluster0

# Option 2: Local MongoDB Instance (For local development fallback)
# MONGO_URI=mongodb://127.0.0.1:27017/maincrafts_todo

